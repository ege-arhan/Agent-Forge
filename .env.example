# Copy to .env and fill in what you use. Never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=

# Require "Authorization: Bearer <key>" on the API (recommended when not on localhost).
AGENTFORGE_API_KEY=
# Disable the unisolated local sandbox on shared servers.
# AGENTFORGE_ALLOW_LOCAL_SANDBOX=false
# Comma-separated permissions agents may never use, e.g. network,github:write
# AGENTFORGE_DENIED_PERMISSIONS=
POSTGRES_PASSWORD=agentforge
